# Copy to backend/.env (or export in your shell) before enabling Gemma rewrite.
# Get a key at: https://aistudio.google.com/apikey

# Django security (required in production when DEBUG=false)
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

GEMINI_API_KEY=
GEMMA_MODEL_ID=gemma-4-31b-it

# Optional Redis (falls back to in-memory Django cache when empty)
REDIS_URL=

# Polite pool identity for OpenAlex / Crossref
SCIENCE_SEARCH_POLITE_EMAIL=noreply@kwantuminstitute.com
SCIENCE_SEARCH_CACHE_TTL=86400

# GraphRAG / KAG (local-first; leave API keys blank for offline mode)
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
BGE_MODEL_PATH=BAAI/bge-small-en-v1.5
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
CONSENSUS_API_KEY=
