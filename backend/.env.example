# Copy this file to .env and fill in real values only if needed.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Qwen inference (default: in-process transformers, no API)
# Leave QWEN_API_BASE empty to stay fully local.
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507

# Local embeddings
BGE_MODEL_PATH=BAAI/bge-small-en-v1.5

# Optional remote evidence sources (disabled by default; leave blank for offline)
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
CONSENSUS_API_KEY=
