# Django / Vercel production & local bootstrap template.
# Copy to .env.local for local pulls, or set these in the Vercel dashboard.

# Required when DEBUG=false
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=

# Optional CORS / CSRF (comma-separated). Leave empty for same-origin production.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Frontend (build-time; optional — defaults already use same-origin /api)
VITE_API_BASE_URL=/api
VITE_GRAPHRAG_API_URL=/api/graphrag

# Optional science search
GEMINI_API_KEY=
GEMMA_MODEL_ID=gemma-4-31b-it
REDIS_URL=
SCIENCE_SEARCH_POLITE_EMAIL=noreply@kwantuminstitute.com
SCIENCE_SEARCH_CACHE_TTL=86400

# GraphRAG / KAG (local-first; leave remote keys blank for offline)
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
BGE_MODEL_PATH=BAAI/bge-small-en-v1.5
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
CONSENSUS_API_KEY=
